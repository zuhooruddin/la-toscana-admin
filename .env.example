# La Toscana admin dashboard — public build-time configuration only (no secrets).
# Copy to .env.local for development.

# Backend API (la-toscana-backend). Its CORS_ORIGINS must include this dashboard's origin.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public website, used for "view on website" links.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
